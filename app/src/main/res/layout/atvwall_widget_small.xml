<?xml version="1.0" encoding="utf-8"?>
<!-- The widget in a small slot (a round app tile): an "i" and "Details"; the title does not fit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/atvwall_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/atvwall_widget_bg_small"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@null"
        android:src="@drawable/atvwall_info_glyph" />

    <TextView
        android:id="@+id/atvwall_widget_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/atvwall_widget_open_short"
        android:textColor="#FFF2EEE6"
        android:textSize="11sp" />
</LinearLayout>
